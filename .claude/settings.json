{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write", "WebFetch", "WebSearch", "TodoWrite", "Task",
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)", "Bash(pnpm:*)", "Bash(yarn:*)", "Bash(bun:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(touch:*)",
      "Bash(rg:*)", "Bash(find:*)", "Bash(grep:*)", "Bash(sed:*)", "Bash(awk:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git branch:*)", "Bash(git checkout:*)",
      "Bash(git stash:*)", "Bash(git init:*)", "Bash(git remote:*)",
      "Bash(gh repo:*)", "Bash(gh auth status:*)", "Bash(gh issue:*)", "Bash(gh pr:*)",
      "Bash(bash scripts/*)", "Bash(sh scripts/*)",
      "Bash(python:*)", "Bash(python3:*)", "Bash(pip:*)",
      "Bash(curl:*)", "Bash(wget:*)", "Bash(pwd)", "Bash(echo:*)", "Bash(which:*)"
    ],
    "ask": [
      "Bash(rm:*)", "Bash(git push:*)", "Bash(sudo:*)",
      "Bash(chmod -R:*)", "Bash(chown -R:*)",
      "Bash(docker:*)", "Bash(psql:*)", "Bash(supabase db reset:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)", "Bash(rm -r:*)", "Bash(rm -f:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git reset --hard:*)", "Bash(git clean -fd:*)",
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)",
      "Read(./**/id_rsa)", "Read(./**/*.pem)", "Read(./**/credentials.json)"
    ]
  }
}
