{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    }
  },
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "oc/big-pickle": { "name": "Big Pickle" },
        "oc/deepseek-v4-flash-free": { "name": "DeepSeek V4 Flash Free" },
        "oc/minimax-m3-free": { "name": "MiniMax M3 Free" },
        "oc/minimax-m2.5-free": { "name": "MiniMax M2.5 Free" },
        "oc/qwen3.6-plus-free": { "name": "Qwen3.6 Plus Free" },
        "oc/nemotron-3-super-free": { "name": "Nemotron 3 Super Free" },
        "oc/trinity-large-preview-free": { "name": "Trinity Large Preview Free" },
        "oc/ling-2.6-1t-free": { "name": "Ling 2.6 1T Free" },
        "auto/best-coding": { "name": "Auto Best Coding" },
        "auto/best-reasoning": { "name": "Auto Best Reasoning" },
        "auto/best-free": { "name": "Auto Best Free" },
        "auto/claude-opus": { "name": "Auto Claude Opus" },
        "auto/claude-sonnet": { "name": "Auto Claude Sonnet" },
        "auto/coding": { "name": "Auto Coding" },
        "auto/reasoning": { "name": "Auto Reasoning" },
        "auto/cheap": { "name": "Auto Cheap" },
        "auto/gemini": { "name": "Auto Gemini" },
        "aug/claude-sonnet-4.6": { "name": "Claude Sonnet 4.6 (Augment)" },
        "aug/claude-opus-4.6": { "name": "Claude Opus 4.6 (Augment)" },
        "aug/claude-haiku-4.5": { "name": "Claude Haiku 4.5 (Augment)" },
        "aug/gemini-3.1-pro": { "name": "Gemini 3.1 Pro (Augment)" },
        "aug/gpt-5.5-high": { "name": "GPT-5.5 High (Augment)" }
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "ironwake.execution.yaml",
    "docs/*.md",
    "state/*.md",
    "state/*.yaml",
    "inputs/*.md"
  ],
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "allow",

      "rm -rf *": "deny",
      "rm -r *": "deny",
      "rm -f *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",

      "rm *": "ask",
      "git push*": "ask",
      "sudo *": "ask",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "docker *": "ask",
      "psql *": "ask",
      "supabase db reset*": "ask"
    },
    "webfetch": "allow",
    "external_directory": "allow",
    "question": "allow"
  },
  "agent": {
    "build": {
      "description": "OpenCode IronWake controlled executor. Reads the durable stage state and performs only the currently allowed role.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow",
          "rm -rf *": "deny",
          "rm -r *": "deny",
          "git push --force*": "deny",
          "git reset --hard*": "deny",
          "rm *": "ask",
          "git push*": "ask",
          "sudo *": "ask"
        },
        "webfetch": "allow"
      }
    },
    "plan": {
      "description": "Read-only IronWake planning and audit agent.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "allow",
          "rm *": "deny",
          "git push*": "deny",
          "git commit*": "deny",
          "sudo *": "deny"
        },
        "webfetch": "allow"
      }
    }
  },
  "command": {
    "ironwake-start": {
      "description": "Start or safely resume the OpenCode-governed IronWake pipeline.",
      "agent": "build",
      "template": "Read and execute prompts/00_START_OR_RESUME.md. Use Hermes Governed MCP for permitted governance operations and Composio MCP for permitted external-app operations. Do not skip the state gate or invent model identity."
    },
    "ironwake-c1": {
      "description": "Run the C1 architecture, research and sealed-queue stage.",
      "agent": "build",
      "template": "Execute only prompts/10_OPENCODE_STAGE_C1_ARCHITECT.md. Stop at the approval gate."
    },
    "ironwake-m1": {
      "description": "Implement the sealed M1 queue.",
      "agent": "build",
      "template": "Execute only prompts/11_OPENCODE_STAGE_M1_IMPLEMENT.md. Do not redesign or add unqueued scope."
    },
    "ironwake-c2": {
      "description": "Independently audit the M1 result and seal remediation.",
      "agent": "plan",
      "template": "Execute only prompts/12_OPENCODE_STAGE_C2_AUDIT.md. Inspect actual files and evidence."
    },
    "ironwake-m2": {
      "description": "Apply the sealed remediation queue.",
      "agent": "build",
      "template": "Execute only prompts/13_OPENCODE_STAGE_M2_REMEDIATE.md. Fix only the sealed queue."
    },
    "ironwake-c3": {
      "description": "Perform the final independent release gate.",
      "agent": "plan",
      "template": "Execute only prompts/14_OPENCODE_STAGE_C3_FINAL_GATE.md. Never deploy automatically."
    },
    "ironwake-deploy": {
      "description": "Deploy and hand over only after recorded production approval.",
      "agent": "build",
      "template": "Execute only prompts/07_PHASE_6_DEPLOY_AND_HANDOVER.md after verifying production approval in inputs/APPROVALS.md."
    }
  }
}
