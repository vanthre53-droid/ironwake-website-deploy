# Public
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BRAND_NAME=IronWake
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# AI triage — server-only (MiniMax M3, OpenAI-compatible Chat Completions)
AI_API_BASE=https://api.minimax.io/v1
AI_API_KEY=
AI_MODEL=MiniMax-M3

# Application security
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# IndexNow key for Bing/Yandex URL submission (https://indexnow.org)
# Rotate via wrangler secret INDEXNOW_KEY in production
INDEXNOW_KEY=

# Transactional email
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_NOTIFICATION_RECIPIENT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Abuse protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Deployment only — never browser-accessible
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Meta WhatsApp Cloud API — server-only secrets
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=
META_WABA_ID=
META_BUSINESS_ID=

# Customer-facing wa.me number (E.164, e.g. +919876543210). When this is
# unset, the FloatingActions panel falls back to the in-page WhatsApp widget
# powered by /api/whatsapp/start (Meta Cloud API outbound). When this IS set,
# the chooser also exposes a direct wa.me deep-link for users who prefer it.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_PREFILL=
