# Separate candidate source workspace. It is not part of the controller baseline.
/ironwakeportifolioprojects/

# Local-only OpenCode dependencies and historical configuration copies.
/.opencode/
/opencode.json.before-fix
/opencode.json.save

# Never track local environment values.
.env
.env.*
!.env.example

# Local build and tooling output.
/.next/
/node_modules/
/.ironwake/
/graphify-out/
.open-next
.dev.vars
/.netlify/
/.wrangler/

# local runtime / database artifacts (not source, not part of the release candidate)
hermes.db
kernel.db
runtime/

# Strix security-run evidence lives outside the release tree.
strix_runs/

# Local screenshot evidence from visual audits is kept in-tree but not committed.
/reports/evidence/**/*.png
.hermes/
.worktrees/
lighthouse.*/
