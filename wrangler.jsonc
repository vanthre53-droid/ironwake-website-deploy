{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker-entry.js",
  "name": "ironwake",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ironwake"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ironwake.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.ironwake.dev",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
