+
+/* === IronWake loading / skeleton system =================================
+   Skeletons represent REAL asynchronous waiting. They use neutral surfaces
+   tuned to the light-first design and a subtle pulse — never aggressive
+   shimmer, never neon, never layout-thrashing. Geometry is content-shaped
+   so the loaded state does not jump. Honors prefers-reduced-motion. */
+:root {
+  --iw-skel-bg: rgb(16 35 44 / .06);
+  --iw-skel-highlight: rgb(255 255 255 / .85);
+  --iw-skel-radius-sm: 4px;
+  --iw-skel-radius-md: 8px;
+  --iw-skel-radius-lg: 14px;
+  --iw-skel-pulse-ms: 1400ms;
+}
+
+.iw-skel {
+  display: block;
+  background: var(--iw-skel-bg);
+  position: relative;
+  overflow: hidden;
+  transform: translateZ(0);
+  isolation: isolate;
+}
+.iw-skel::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    90deg,
+    transparent 0%,
+    var(--iw-skel-highlight) 50%,
+    transparent 100%
+  );
+  transform: translateX(-100%);
+  animation: iw-skel-shimmer var(--iw-skel-pulse-ms) cubic-bezier(.4, 0, .2, 1) infinite;
+  will-change: transform, opacity;
+  opacity: .55;
+  border-radius: inherit;
+}
+@keyframes iw-skel-shimmer {
+  0%   { transform: translateX(-100%); }
+  60%  { transform: translateX(100%); }
+  100% { transform: translateX(100%); }
+}
+
+.iw-skel-card {
+  border: 1px solid var(--stone);
+  border-radius: 14px;
+  padding: 1.5rem;
+  background: var(--surface);
+  display: flex;
+  flex-direction: column;
+  gap: .85rem;
+  min-height: 132px;
+}
+.iw-skel-card-eyebrow { opacity: .85; }
+.iw-skel-card-title { margin: 2px 0 4px; }
+.iw-skel-card-body { display: flex; flex-direction: column; gap: 4px; }
+
+.iw-skel-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
+.iw-skel-list-row {
+  display: flex;
+  gap: 12px;
+  align-items: center;
+  padding: 12px 14px;
+  background: var(--paper);
+  border: 1px solid var(--stone-soft);
+  border-radius: 10px;
+}
+.iw-skel-list-row-body { display: flex; flex-direction: column; gap: 6px; flex: 1 1 auto; min-width: 0; }
+
+.iw-skel-conversation { display: flex; flex-direction: column; gap: 10px; padding: 4px 0; }
+.iw-skel-bubble-row { display: flex; }
+.iw-skel-bubble-row-user    { justify-content: flex-end; }
+.iw-skel-bubble-row-assistant { justify-content: flex-start; }
+.iw-skel-bubble { background: var(--paper); }
+
+.iw-skel-account-section {
+  border: 1px solid var(--stone);
+  border-radius: 14px;
+  padding: 1.5rem;
+  background: var(--surface);
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  min-height: 180px;
+}
+.iw-skel-account-section-title { margin: 2px 0 4px; }
+.iw-skel-account-section-rows { display: flex; flex-direction: column; gap: 6px; padding: 6px 0; }
+.iw-skel-account-section-action { margin-top: 8px; align-self: flex-start; }
+
+.iw-skel-nav-auth {
+  border-radius: 999px;
+  background: var(--iw-skel-bg);
+  vertical-align: middle;
+}
+
+/* === Loading / spinner micro-interactions =============================== */
+.iw-loading-inline {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--ink-soft);
+  font-size: 12px;
+}
+.iw-loading-dot {
+  width: 6px; height: 6px;
+  border-radius: 50%;
+  background: var(--copper);
+  display: inline-block;
+  animation: iw-loading-dot 1.1s cubic-bezier(.4, 0, .2, 1) infinite both;
+}
+.iw-loading-dot:nth-child(2) { animation-delay: .15s; }
+.iw-loading-dot:nth-child(3) { animation-delay: .3s; }
+@keyframes iw-loading-dot {
+  0%, 80%, 100% { transform: scale(.6); opacity: .35; }
+  40%           { transform: scale(1);   opacity: 1;   }
+}
+
+/* Submitting form: button shows restrained inline progress without
+   disturbing the form geometry. The form fieldset is disabled (not hidden)
+   so screen readers announce the state change. */
+.iw-form-submitting { position: relative; }
+.iw-form-submitting .auth-field,
+.iw-form-submitting .auth-terms,
+.iw-form-submitting .auth-submit,
+.iw-form-submitting .auth-aside {
+  pointer-events: none;
+  opacity: .55;
+  transition: opacity .2s ease;
+}
+.iw-form-submitting .auth-submit {
+  opacity: 1;
+  pointer-events: auto;
+}
+
+/* Reduced motion: kill the shimmer / pulse, keep static skeleton shape. */
+@media (prefers-reduced-motion: reduce) {
+  .iw-skel::after { animation: none; opacity: 0; transform: none; }
+  .iw-loading-dot { animation: none; opacity: .65; transform: none; }
+  .iw-skel,
+  .iw-skel-card,
+  .iw-skel-account-section,
+  .iw-skel-list-row,
+  .iw-skel-bubble { transition: none !important; }
+}