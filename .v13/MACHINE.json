{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironwake.dev/schemas/v13/machine.schema.json",
  "title": "IronWakeV13GlobalStateMachine",
  "version": "13.0.0",
  "generated": "2026-08-18",
  "source_of_record": ".v13/TODO.md §GLOBAL_STATE",
  "initial_state": "BOOTSTRAPPING",
  "success_states": ["FULLY_VERIFIED"],
  "absorbing_states": ["FULLY_VERIFIED"],
  "degraded_states": ["PARTIAL", "BLOCKED", "STALE"],
  "referenced_items": ["1","3","5","6","8","11","12","13","14","15","18","19","20","21","22","26","27","28","29","33","39","40","41","42","43","47","48"],
  "evaluation_context": {
    "current_state": "string — one of state.id",
    "items": "list of 50 goal-map items, each {id, status, evidence}",
    "audit_findings": "list of severity-ranked findings {id, severity, owner_gated}",
    "deploy_attempts_used": "integer, 0..4",
    "deploy_attempts_max": "integer = 4",
    "external_blockers": "list of {id, owner, kind}",
    "local_executable_open": "integer — remaining items not yet DONE nor BLOCKED"
  },
  "states": [
    {
      "id": "BOOTSTRAPPING",
      "kind": "start",
      "description": "Workspace, kanban, design skills, palette, Ruflo clone ready.",
      "entry_required_items": ["1", "3", "6", "8", "11", "12", "33", "48"],
      "exit_required_items": ["1", "3", "6"],
      "invariants": [
        "repo .v13/TODO.md exists",
        "kanban board ironwake-v13-full-implementation is bound"
      ]
    },
    {
      "id": "DESIGN_LOCKED",
      "kind": "normal",
      "description": "Design system tokens + glass + palette committed and sealed.",
      "entry_required_items": ["13"],
      "exit_required_items": ["13"],
      "invariants": [
        "app/globals.css token block has status LOCKED-NO-TOUCH",
        "palette/glass values match TODO.md §DESIGN DIRECTION"
      ]
    },
    {
      "id": "ROUTE_AUDITED",
      "kind": "normal",
      "description": "All 24 public routes enumerated and acceptance-tested in matrix.",
      "entry_required_items": ["15"],
      "exit_required_items": ["15"]
    },
    {
      "id": "ROUTING_OK",
      "kind": "normal",
      "description": "Routing/redirects/sitemap/robots verified green.",
      "entry_required_items": ["14", "15"],
      "exit_required_items": ["14", "15"]
    },
    {
      "id": "AUTH_OK",
      "kind": "normal",
      "description": "Google auth + customer account flows reverified end-to-end.",
      "entry_required_items": ["19"],
      "exit_required_items": ["19"]
    },
    {
      "id": "BACKEND_OK",
      "kind": "normal",
      "description": "Supabase live schema, RLS, unified identity, idempotency verified.",
      "entry_required_items": ["22"],
      "exit_required_items": ["22"]
    },
    {
      "id": "INTEGRATIONS_OK",
      "kind": "normal",
      "description": "Retell, WhatsApp/Meta, chatbot canonical truth layer live.",
      "entry_required_items": ["18", "20", "21"],
      "exit_required_items": ["18", "20", "21"]
    },
    {
      "id": "PROVIDERS_VERIFIED",
      "kind": "normal",
      "description": "Each third-party provider probed read-only with capability matrix.",
      "entry_required_items": ["5"],
      "exit_required_items": ["5"]
    },
    {
      "id": "PERF_OK",
      "kind": "normal",
      "description": "LCP<2.5s, INP<200ms, CLS<0.1 verified on /, /pricing, /audit.",
      "entry_required_items": ["26"],
      "exit_required_items": ["26"],
      "thresholds": {
        "lcp_seconds_max": 2.5,
        "inp_ms_max": 200,
        "cls_max": 0.1
      }
    },
    {
      "id": "A11Y_OK",
      "kind": "normal",
      "description": "axe-core + manual a11y sweep green; no critical violations.",
      "entry_required_items": ["27"],
      "exit_required_items": ["27"]
    },
    {
      "id": "SECURITY_OK",
      "kind": "normal",
      "description": "dep/secret/RLS/IDOR/CSRF/XSS/SSRF/webhook forgery probes clean.",
      "entry_required_items": ["28"],
      "exit_required_items": ["28"]
    },
    {
      "id": "BUILD_OK",
      "kind": "normal",
      "description": "Build green, bundle <1MB, no pre-existing test regressions.",
      "entry_required_items": ["29"],
      "exit_required_items": ["29"]
    },
    {
      "id": "RELEASE_CANDIDATE",
      "kind": "normal",
      "description": "Gate passed: S4 cleared, S6 evidence finalised, audit summary clean.",
      "entry_required_items": ["39", "43"],
      "exit_required_items": ["39", "43"]
    },
    {
      "id": "DEPLOYED",
      "kind": "normal",
      "description": "One Cloudflare deploy recorded with SHA + bundle size + commit.",
      "entry_required_items": ["40"],
      "exit_required_items": ["40"],
      "constraints": {
        "deploy_attempts_used_increment": 1
      }
    },
    {
      "id": "LIVE_ACCEPTANCE",
      "kind": "normal",
      "description": "Post-deploy curl + IndexNow re-submit + GSC URL inspection green.",
      "entry_required_items": ["41", "42"],
      "exit_required_items": ["41", "42"]
    },
    {
      "id": "FULLY_VERIFIED",
      "kind": "success",
      "description": "All 50 items DONE or BLOCKED; final report emitted.",
      "entry_required_items": ["47"],
      "exit_required_items": ["47"]
    },
    {
      "id": "PARTIAL",
      "kind": "degraded",
      "description": "A subset of items is DONE; remaining are open with a stated reason.",
      "must_record": ["reason", "remaining_items"]
    },
    {
      "id": "BLOCKED",
      "kind": "degraded",
      "description": "An external/owner-gated dependency prevents progress; must record blocker.",
      "must_record": ["reason", "owner", "external_blocker_id"]
    },
    {
      "id": "STALE",
      "kind": "degraded",
      "description": "Truth layer has drifted from reality; refresh required before proceeding.",
      "must_record": ["reason", "stale_files"]
    }
  ],
  "transitions": [
    {
      "from": "BOOTSTRAPPING",
      "to": "DESIGN_LOCKED",
      "predicate": "item_status('13') in {DONE, DONE-in-design, PARTIAL}",
      "on_enter": ["freeze app/globals.css token block as LOCKED-NO-TOUCH"]
    },
    {
      "from": "DESIGN_LOCKED",
      "to": "ROUTE_AUDITED",
      "predicate": "item_status('15') in {DONE, PARTIAL}",
      "on_enter": [
        "enumerate 24 routes from TRUTH.json routes[*].path",
        "emit ROUTE_ACCEPTANCE_MATRIX"
      ]
    },
    {
      "from": "ROUTE_AUDITED",
      "to": "ROUTING_OK",
      "predicate": "all_routes_pass_acceptance() and item_status('14') != NOT_RUN",
      "on_enter": ["verify robots/sitemap/canonical/og against site url"]
    },
    {
      "from": "ROUTING_OK",
      "to": "AUTH_OK",
      "predicate": "item_status('19') == DONE",
      "on_enter": ["exercise /login, /signup, /account, /forgot-password, /update-password"]
    },
    {
      "from": "AUTH_OK",
      "to": "BACKEND_OK",
      "predicate": "item_status('22') == DONE and supabase_rls_verified()",
      "on_enter": ["live schema introspection via MCP/SQL"]
    },
    {
      "from": "BACKEND_OK",
      "to": "INTEGRATIONS_OK",
      "predicate": "all([item_status(i)==DONE for i in ['18','20','21']])",
      "on_enter": [
        "Retell: list-agents + get-phone-numbers",
        "WhatsApp: safe read-only API probe",
        "Chatbot: /api/chat returns 200 complete for grounded intents"
      ]
    },
    {
      "from": "INTEGRATIONS_OK",
      "to": "PROVIDERS_VERIFIED",
      "predicate": "item_status('5') == DONE and capability_matrix_emitted()",
      "on_enter": ["credential capability matrix covers all 50 items"]
    },
    {
      "from": "PROVIDERS_VERIFIED",
      "to": "PERF_OK",
      "predicate": "item_status('26') == DONE and perf_thresholds_met()",
      "on_enter": ["Lighthouse mobile+desktop on /, /pricing, /audit"]
    },
    {
      "from": "PERF_OK",
      "to": "A11Y_OK",
      "predicate": "item_status('27') == DONE and axe_critical_violations()==0",
      "on_enter": ["axe-core on /, /pricing, /audit"]
    },
    {
      "from": "A11Y_OK",
      "to": "SECURITY_OK",
      "predicate": "item_status('28') == DONE and no_critical_security_findings()",
      "on_enter": ["npm audit, secret-scan, IDOR/CSRF/XSS/SSRF probes"]
    },
    {
      "from": "SECURITY_OK",
      "to": "BUILD_OK",
      "predicate": "item_status('29') == DONE and test_suite_all_green() and bundle_size_bytes()<1048576"
    },
    {
      "from": "BUILD_OK",
      "to": "RELEASE_CANDIDATE",
      "predicate": "item_status('39') == DONE and item_status('43') == DONE and external_blockers_empty()"
    },
    {
      "from": "RELEASE_CANDIDATE",
      "to": "DEPLOYED",
      "predicate": "deploy_attempts_used < deploy_attempts_max",
      "on_enter": [
        "increment deploy_attempts_used",
        "record deploy {sha, bundle_bytes, commit}"
      ]
    },
    {
      "from": "DEPLOYED",
      "to": "LIVE_ACCEPTANCE",
      "predicate": "item_status('41') == DONE and item_status('42') == DONE"
    },
    {
      "from": "LIVE_ACCEPTANCE",
      "to": "FULLY_VERIFIED",
      "predicate": "item_status('47') == DONE and local_executable_open == 0"
    },
    {
      "from": "*",
      "to": "PARTIAL",
      "predicate": "local_executable_open > 0 and user_requests_partial()",
      "must_record": ["reason", "remaining_items"]
    },
    {
      "from": "*",
      "to": "BLOCKED",
      "predicate": "any_owner_gated_finding_open() or any_external_blocker_open()",
      "must_record": ["reason", "owner", "external_blocker_id"]
    },
    {
      "from": "*",
      "to": "STALE",
      "predicate": "truth_drift_detected()",
      "must_record": ["reason", "stale_files"]
    },
    {
      "from": "BLOCKED",
      "to": "BOOTSTRAPPING",
      "predicate": "all_external_blockers_cleared() and item_status('1') == DONE",
      "note": "Resume from start only when the blocker source is the workspace itself."
    },
    {
      "from": "PARTIAL",
      "to": "BOOTSTRAPPING",
      "predicate": "user_requests_resume()",
      "note": "Owner may resume a partial run; reset to start, keep evidence."
    },
    {
      "from": "STALE",
      "to": "BOOTSTRAPPING",
      "predicate": "truth_layer_refreshed()",
      "note": "Refresh .v13/TODO.md and TRUTH.json from reality before resuming."
    }
  ],
  "global_guards": [
    {
      "id": "NO_FAKE_COMPLETION",
      "rule": "for every item with status DONE, an evidence field referencing a commit SHA, capsule path, or live URL must exist"
    },
    {
      "id": "ANTI_STALL",
      "rule": "if local_executable_open > 0 and elapsed_since_last_progress > 600s, force transition to BLOCKED with reason 'stall'"
    },
    {
      "id": "EXTERNAL_FORMAT",
      "rule": "every transition into BLOCKED must populate an External Gate Format record {owner, command, verify_phrase}"
    }
  ],
  "local_executable_open": {
    "definition": "count(items where status not in {DONE, BLOCKED, NOT_RUN})",
    "rules": [
      "while > 0: keep acting",
      "when == 0 and current_state != FULLY_VERIFIED: prompt user with 'continue?'"
    ]
  }
}